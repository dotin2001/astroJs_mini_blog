<div class="overflow-hidden bg-gray-900 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2"
    >
      <div class="lg:pt-4 lg:pr-8">
        <div class="lg:max-w-lg">
          <h2 id="authorRole" class="text-base/7 font-semibold text-indigo-400">
            Author Information
          </h2>
          <p
            id="authorName"
            class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-white sm:text-5xl"
          >
            Name
          </p>
          <p id="authorDesc" class="mt-6 mb-6 text-lg/8 text-gray-300">
            Lorem ipsum, dolor sit amet consectetur adipisicing elit. Maiores
            impedit perferendis suscipit eaque, iste dolor cupiditate blanditiis
            ratione.
          </p>
          <button
            class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded inline-flex items-center cursor-pointer"
          >
            <span>Update</span>
          </button>
        </div>
      </div>
      <img
        id="authorAvtImg"
        width="2432"
        height="1442"
        src="https://cdn2.fptshop.com.vn/unsafe/1920x0/filters:format(webp):quality(75)/Sanji_one_piece_6_b73fb9110e.png"
        alt="Product screenshot"
        class="w-full rounded-xl shadow-xl ring-1 ring-white/10 sm:w-228 md:-ml-4 lg:-ml-0"
      />
    </div>
  </div>
</div>

<script>
  import { authService } from "@/services/auth.service";
  const res = await authService.getProfile();
  const user = res.user;
  console.log(user);

  const authorRole = document.getElementById("authorRole");
  const authorName = document.getElementById("authorName");
  const authorDesc = document.getElementById("authorDesc");
  const authorAvtImg = document.getElementById("authorAvtImg");
  authorRole.innerHTML = user.role;
  authorName.innerHTML = user.name;
  authorDesc.innerHTML = user.description;
  authorAvtImg.src = user.avatar;
</script>
