---
const blog_infor = Astro.props.blog;
---

<article class="flex flex-col items-start justify-between">
  <div class="flex items-center gap-x-4 text-xs">
    <time datetime="2020-03-16" class="text-gray-400">{blog_infor.time}</time>
  </div>
  <div class="group relative grow">
    <h3
      class="mt-3 text-lg/6 font-semibold text-white group-hover:text-gray-300"
    >
      <a href="#">
        <span class="absolute inset-0"></span>
        {blog_infor.title}
      </a>
    </h3>
    <p class="mt-5 line-clamp-3 text-sm/6 text-gray-400">
      {blog_infor.description}
    </p>
  </div>
  <div class="relative mt-8 flex items-center gap-x-4 justify-self-end">
    <img
      src={blog_infor.author_avt}
      alt=""
      class="size-10 rounded-full bg-gray-800"
    />
    <div class="text-sm/6">
      <p class="font-semibold text-white">
        <a href="#">
          <span class="absolute inset-0"></span>
          {blog_infor.author}
        </a>
      </p>
      <p class="text-gray-400">{blog_infor.role}</p>
    </div>
  </div>
</article>
